# Copy this file to .env and fill in your own values.
# Never commit your real .env file anywhere public.

PORT=4200
PENY_DATA_DIR=/data

# Optional — only needed if you want read-only bank sync.
# Get these free from https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
